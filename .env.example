# ---- Veritabanı (Docker Postgres) ----
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=supersecret123
POSTGRES_DB=ecommerce_db

# ---- JWT (production'da MUTLAKA değiştir!) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Gemini AI (chatbot) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- İlk kurulumda örnek veriyi yükle (sonra false yap) ----
RUN_SEED=true
